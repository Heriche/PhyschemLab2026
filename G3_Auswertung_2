M = 12.011

def P_int(pts, tend):
    tt = [p[0] for p in pts]
    PP = [p[1] for p in pts]
    if tt[0] > 0:
        tt = [0] + tt
        PP = [PP[0]] + PP
    tt.append(tend)
    PP.append(PP[-1])
    return np.trapezoid(PP, tt)

