def fit(t, T, a, b):
    m = (t >= a) & (t <= b)
    return np.polyfit(t[m], T[m], 1)

def tx_dT(t, T, pv, pn, t0, t1, extra=None):
    tt = np.linspace(t0, t1, 20001)
    TT = np.interp(tt, t, T)
    L = TT - np.polyval(pv, tt)
    R = np.polyval(pn, tt) - TT
    cl = np.concatenate([[0], np.cumsum((L[1:] + L[:-1]) / 2 * np.diff(tt))])
    cr = np.concatenate([[0], np.cumsum((R[1:] + R[:-1]) / 2 * np.diff(tt))])
    right = cr[-1] - cr
    if extra:
        cl = cl + extra
    i = np.argmin(abs(cl - right))
    return tt[i], np.polyval(pn, tt[i]) - np.polyval(pv, tt[i]), cl[i], right[i]

