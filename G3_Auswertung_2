def res(Q, dTk_, dTc_, m, rest, dw, ign):
    C = Q / dTk_
    Qt = C * dTc_
    net = Qt - dw * 5 - ign
    n = (m - rest) / M
    return C, Qt, net, n * 1000, -net / n / 1000

