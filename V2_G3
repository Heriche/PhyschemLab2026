def fit_frei(x, y):
    (m, b), cov = np.polyfit(x, y, 1, cov=True)
    return m, np.sqrt(cov[0, 0]), b, np.sqrt(cov[1, 1])
 
def fit_ursprung(x, y):
    x, y = np.asarray(x, float), np.asarray(y, float)
    m0 = np.sum(x * y) / np.sum(x * x)
    se = np.sqrt(np.sum((y - m0 * x) ** 2) / (len(x) - 1) / np.sum(x * x))
    return m0, se
 
def zeile(name, m, sm, b, sb, m0, sm0, erwartung):
    print(f"{name:>10}: m = {m:.5e} +- {sm:.1e} | b = {b:+.3e} +- {sb:.1e} | "
          f"m0 = {m0:.5e} +- {sm0:.1e} | Erwartung = {erwartung:.5e} | m0/Erw.-1 = {100*(m0/erwartung-1):+.3f} %")
 
