def abbildung(dateiname, kurven, xlabel, ylabel, xmax):
    fig, ax = plt.subplots(figsize=(4.6, 3.5))
    for label, x, y, sd, farbe in kurven:
        ax.errorbar(x, y, yerr=sd, fmt="o", ms=4, capsize=2, color=farbe, label=label)
        m, _, b, _ = fit_frei(x, y)
        ax.plot([0, xmax], [b, m * xmax + b], "-", lw=1, color=farbe)
    ax.set_xlabel(xlabel)
    ax.set_ylabel(ylabel)
    ax.legend(frameon=False)
    fig.tight_layout()
    fig.savefig(dateiname)
    plt.close(fig)


